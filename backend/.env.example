APP_ENV=development
APP_NAME=PrivAI MVP API
API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=sqlite:///./storage/privai.db

MODEL_PATH=./models/privai_yolo.pt
MODEL_DEVICE=auto

DEFAULT_CONFIDENCE_THRESHOLD=0.35
DEFAULT_REDACTION_MODE=black_box
DEFAULT_ACTIVE_CLASSES=KTP,SIM,Paspor,NIK_Teks,Wajah,Plat_Nomor

OPERATIONAL_ZONE_DIR=./storage/operational_zone
SOVEREIGN_VAULT_DIR=./storage/sovereign_vault
AUDIT_LOG_DIR=./storage/audit

KEK_SIMULATION_SECRET=change_this_to_a_long_random_secret_for_demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

USER_ZONE_DIR=./storage/user_zone

VAULT_KEY_ID_PREFIX=privai-vault-rsa-oaep-demo

GOVERNMENT_API_TOKEN=privai-government-demo-token
GOVERNMENT_APPROVER_TOKEN=privai-approver-demo-token
CRYPTO_ADMIN_TOKEN=privai-crypto-admin-demo-token

GOVERNMENT_ACCESS_TOKEN_TTL_MINUTES=15

RUNTIME_POLICY_PATH=./storage/config/runtime_policy.json